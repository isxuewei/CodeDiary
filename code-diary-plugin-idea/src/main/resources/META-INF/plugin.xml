<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>fun.xuewei.codediary</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>CodeDiary</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor email="isxuwei@qq.com" url="http://xuewei.fun">薛伟同学</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Simple HTML elements (text formatting, paragraphs, and lists) can be added inside of <![CDATA[ ]]> tag.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description><![CDATA[
      <p>CodeDiary is an IntelliJ plugin that generates daily reports from Git commit history.</p>
      </br>
      <p>根据 Git 提交记录生成日报。</p>
      <p><b>主要功能：</b></p>
      <ul>
        <li>自动扫描项目及子目录中的多个 Git 仓库，支持按仓库和时间范围查询提交</li>
        <li>勾选需要纳入日报的提交，点击行可联动多选</li>
        <li>悬停查看提交详情（Hash、作者、时间、完整信息）</li>
        <li>配置日报格式示例与补充内容，供生成服务 / AI 参考</li>
        <li>一键生成日报：调用 CodeDiary 后端服务，生成后可一键复制</li>
        <li>在 Commit 面板根据已勾选的代码变更生成并回填 Git 提交日志</li>
      </ul>
      <p>在右侧工具窗口打开 CodeDiary，选择日期并查询提交，勾选后点击「生成」即可。</p>
      <p>插件官网：https://code-diary.xuewei.fun，作者公众号：薛伟同学</p>
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <actions>
        <action id="CodeDiary.GenerateGitCommitLog"
                class="fun.xuewei.codediary.GenerateGitCommitLogAction"
                text="生成 Git 提交日志"
                description="根据已选择的代码变更生成 Git 提交日志"
                icon="/icons/codeDiary.svg">
            <add-to-group group-id="Vcs.MessageActionGroup" anchor="last"/>
        </action>
    </actions>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="fun.xuewei.codediary.CodeDiarySettings"/>
        <toolWindow id="CodeDiary"
                    anchor="right"
                    icon="/icons/codeDiary.svg"
                    factoryClass="fun.xuewei.codediary.CodeDiaryToolWindowFactory"/>
    </extensions>
</idea-plugin>
